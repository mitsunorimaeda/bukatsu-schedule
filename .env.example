# コピーして .env にする（.env は Git 管理外。鍵はチャットに貼らずファイルに直接書く）

# --- Claude API（CLI の AI 読み取り用。無ければ AI_MODE=mock で fixtures/ai-responses/ の記録を使う） ---
ANTHROPIC_API_KEY=
AI_MODE=mock            # mock | live | record

# --- ローカル Supabase（supabase start → supabase status -o env の値） ---
SUPABASE_URL=http://127.0.0.1:54341
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- 本番の Supabase（npm run load -- --target cloud で使う。自分のプロジェクトの値） ---
SUPABASE_CLOUD_URL=
SUPABASE_CLOUD_ANON_KEY=             # Project Settings → API Keys → publishable (anon)
SUPABASE_CLOUD_SERVICE_ROLE_KEY=     # 同 → service_role（secret）
